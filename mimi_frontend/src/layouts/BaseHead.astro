---
import '@blueprintjs/core/lib/css/blueprint.css';
import '@blueprintjs/icons/lib/css/blueprint-icons.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="mimi — a language-learning app." />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/png" href="/favicon.png" />

<!-- DINish Next carries the whole UI; preload the two weights on the critical
     path so they arrive alongside the CSS rather than after it. -->
<link
  rel="preload"
  href="/fonts/dinish-next-400.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/dinish-next-700.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- DINish Next has no kana or kanji; Noto Sans JP covers Japanese. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
/>

<title>{title} · mimi</title>

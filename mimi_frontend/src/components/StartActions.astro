---
import Arrow from "./Arrow.astro";
import { Icon } from "@blueprintjs/core";
import { EDITOR_URL } from "../data/site";

/* The landing page's pair of buttons: start learning, or open the course
   editor. The editor is the other half of the pitch, a course anyone can
   contribute to needs somewhere to contribute, so it gets the second
   button, with its local or deployed address supplied by data/site.ts. */
interface Props {
    class: string;
}

const { class: className } = Astro.props;
---

<div class={className}>
    <a class="land-btn land-btn--regular" href="/learn">
        Get started
        <Arrow size={16} />
    </a>
    <a
        class="land-btn land-btn--quiet land-btn--regular"
        href={EDITOR_URL}
        target="_blank"
        rel="noopener noreferrer"
        >Open the course editor
        <Icon icon="share" size={11} aria-hidden />
    </a>
</div>

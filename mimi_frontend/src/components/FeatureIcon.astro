---
import noAiIcon from "../assets/noun-robotics-7005145.svg";

/* The icons that head the feature cards. Most are inline paths rather than an
   icon font or Blueprint's <Icon>: they never change, cost no JavaScript, and
   take their colour from the card they sit in. The no-AI icon uses the credited
   source artwork instead. */
interface Props {
    name:
        | "edit"
        | "no-ai"
        | "tailored"
        | "open-source"
        | "difficulty"
        | "schedule";
    size?: number;
}

const { name, size = 26 } = Astro.props;
const noAiWidth = Math.round(size * (106.49185 / 79.685677));
---

{
    name === "no-ai" ? (
        <img
            class="feature-icon feature-icon--no-ai"
            src={noAiIcon.src}
            width={noAiWidth}
            height={size}
            alt=""
            aria-hidden="true"
        />
    ) : (
        <svg
            class="feature-icon"
            width={size}
            height={size}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            {/* a pencil mid-edit, the course is a wiki, and this is the button */}
            {name === "edit" && (
                <path d="M17 3.2a2.6 2.6 0 0 1 3.8 3.8L7.6 20.2 2.4 21.6l1.4-5.2Z" />
            )}

            {/* three sliders, each set somewhere different, a lesson tuned to a reader */}
            {name === "tailored" && (
                <Fragment>
                    <path d="M3 6h9M17 6h4M3 12h5M13 12h8M3 18h11M19 18h2" />
                    <circle cx="14.5" cy="6" r="2.2" />
                    <circle cx="10.5" cy="12" r="2.2" />
                    <circle cx="16.5" cy="18" r="2.2" />
                </Fragment>
            )}

            {/* the source, opened */}
            {name === "open-source" && (
                <Fragment>
                    <path d="M9 5.5 3.5 12 9 18.5M15 5.5 20.5 12 15 18.5" />
                    <path d="M13.2 4.5 10.8 19.5" />
                </Fragment>
            )}

            {/* a target, hit near but not on the bullseye, 85%, not 100% */}
            {name === "difficulty" && (
                <Fragment>
                    <circle cx="12" cy="12" r="8.6" />
                    <circle cx="12" cy="12" r="4.4" />
                    <circle
                        cx="12"
                        cy="12"
                        r="1.5"
                        fill="currentColor"
                        stroke="none"
                    />
                </Fragment>
            )}

            {/* a clock, because the whole trick is when the review lands */}
            {name === "schedule" && (
                <Fragment>
                    <circle cx="12" cy="12" r="8.6" />
                    <path d="M12 7.2V12l3.4 2" />
                </Fragment>
            )}
        </svg>
    )
}

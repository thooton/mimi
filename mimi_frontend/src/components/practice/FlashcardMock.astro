---
/* The review screen, frozen with the answer showing: the card on top, then
   the four FSRS ratings, each wearing the interval it would schedule. A
   drawing, not a working review — the landing ships it no script, so the
   "buttons" below are spans wearing the raised recipe. The words are the
   course's own: this card is the landing demo's first exercise. */
---

<div
    class="mock"
    role="group"
    aria-label="Mockup of the flashcard review screen"
>
    <div class="mock-head">
        <span class="eyebrow">Review</span>
        <span class="mock-aside tnum">14 due today</span>
    </div>

    <div class="flash-card">
        <p class="flash-front">la leche</p>
        <p class="flash-back">the milk</p>
        <p class="flash-example">El gato bebe la leche.</p>
    </div>

    <div class="flash-grades">
        <span class="flash-grade is-again">
            <span class="flash-grade-label">Again</span>
            <span class="flash-grade-when tnum">&lt;10m</span>
        </span>
        <span class="flash-grade">
            <span class="flash-grade-label">Hard</span>
            <span class="flash-grade-when tnum">1d</span>
        </span>
        <span class="flash-grade">
            <span class="flash-grade-label">Good</span>
            <span class="flash-grade-when tnum">3d</span>
        </span>
        <span class="flash-grade">
            <span class="flash-grade-label">Easy</span>
            <span class="flash-grade-when tnum">7d</span>
        </span>
    </div>
</div>

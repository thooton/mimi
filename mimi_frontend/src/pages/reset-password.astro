---
/* Where the emailed link lands. The token rides in `?token=`, which only the
   client reads: this page is prerendered like every other, and mimi_auth's
   MIMI_RESET_URL must point here (http://localhost:4773/reset-password by
   default). */
import AppLayout from '../layouts/AppLayout.astro';
import PasswordResetForm from '../components/PasswordResetForm';
---

<AppLayout title="Choose a new password">
  <PasswordResetForm mode="reset" client:load />
</AppLayout>

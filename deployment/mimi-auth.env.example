# MediaWiki reaches this listener over Docker's host bridge. 172.17.0.1 is the
# standard Linux docker0 address; use the actual address reported by
# `ip -4 addr show docker0` if this host differs.
MIMI_AUTH_ADDR=172.17.0.1:4770
MIMI_AUTH_DB=/home/mimi/mimi_auth/mimi-auth.db

# Password reset email, through Resend. Without a key the service still runs and
# writes each reset link to the log instead of sending it, which is a local
# convenience and a production outage: set the key here and nowhere in the tree.
MIMI_RESEND_API_KEY=re_replace_me
# Must be an address at a domain verified with Resend. The built-in default
# (onboarding@resend.dev) only delivers to the Resend account's own address.
MIMI_RESEND_FROM=Mimi <no-reply@example.com>
# The learner site's page, where somebody following the link from their inbox
# lands. Never a URL on this service: browsers do not reach this port.
MIMI_RESET_URL=https://example.com/reset-password

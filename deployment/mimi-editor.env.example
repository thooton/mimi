MIMI_PORT=127.0.0.1:4771
MIMI_SERVER=https://edit.example.com
MIMI_LEARNER_URL=https://learn.example.com
MIMI_AUTH_URL=http://host.docker.internal:4770
# NGINX redirects public HTTP itself. Leave MediaWiki's own redirect disabled
# so the backend can poll api.php over the private HTTP listener.
MIMI_FORCE_HTTPS=false

# Keep this project's persistent state beside this project's deployment.
MIMI_DATABASE_STORAGE=/home/mimi/mimi_editor/data/database
MIMI_UPLOADS_STORAGE=/home/mimi/mimi_editor/data/uploads

# Generate four independent values with the commands in README.md.
MIMI_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_32
MIMI_ADMIN_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24
MIMI_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
MIMI_UPGRADE_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_8

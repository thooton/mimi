{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mimi glossary",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lemma", "forms"],
        "additionalProperties": false,
        "properties": {
          "lemma": { "type": "string", "minLength": 1, "maxLength": 200 },
          "forms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["form", "translations"],
              "additionalProperties": false,
              "properties": {
                "form": { "type": "string", "maxLength": 200 },
                "translations": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            }
          }
        }
      }
    }
  }
}
